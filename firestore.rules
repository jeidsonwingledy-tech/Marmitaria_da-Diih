rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // AVISO: Estas regras permitem que qualquer pessoa leia e grave no seu banco de dados.
    // Para produção, você deve implementar autenticação (Firebase Auth) e restringir as gravações.
    
    match /{document=**} {
      allow read, write: if true;
    }
  }
}